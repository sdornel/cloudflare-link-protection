{
  "variables": {
    "background": "#f8fafc",
    "text": "#172033",
    "muted": "#536176",
    "accent": "#315dc4",
    "accent-hover": "#2548a1",
    "on-accent": "#ffffff",
    "border": "#d7dfeb",
    "mark-background": "#e1e9f8",
    "mark-text": "#314d7b",
    "font-family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "page-background": "radial-gradient(ellipse at 50% 42%, #e1e9f890, transparent 65%), var(--background)"
  },
  "rules": {
    "*": { "box-sizing": "border-box" },
    "html": { "min-width": "280px", "background": "var(--background)", "color": "var(--text)", "-webkit-text-size-adjust": "100%" },
    "body": { "margin": "0", "min-height": "100svh", "display": "flex", "flex-direction": "column", "font-family": "var(--font-family)", "-webkit-font-smoothing": "antialiased", "background": "var(--page-background)" },
    ".site-header": { "width": "min(100%, 1080px)", "margin-inline": "auto", "padding": "max(28px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right)) 28px max(24px, env(safe-area-inset-left))" },
    ".brand": { "display": "inline-flex", "align-items": "center", "gap": "12px", "min-height": "44px", "max-width": "100%", "text-decoration": "none", "color": "var(--text)", "font-size": "20px", "font-weight": "650", "letter-spacing": "-0.5px", "overflow-wrap": "anywhere" },
    ".brand-mark": { "display": "grid", "place-items": "center", "flex-shrink": "0", "min-width": "42px", "min-height": "42px", "padding": "8px", "border-radius": "14px", "background": "var(--mark-background)", "color": "var(--mark-text)" },
    ".landing": { "width": "min(100%, 920px)", "flex": "1", "align-content": "center", "margin-inline": "auto", "padding": "60px max(24px, env(safe-area-inset-right)) 80px max(24px, env(safe-area-inset-left))", "text-align": "center" },
    ".eyebrow": { "margin": "0 0 24px", "color": "var(--muted)", "font-size": "13px", "font-weight": "600", "letter-spacing": "2px", "text-transform": "uppercase", "line-height": "1.7", "overflow-wrap": "anywhere" },
    "h1": { "margin": "0", "font-size": "clamp(44px, 9vw, 92px)", "font-weight": "650", "letter-spacing": "-0.055em", "line-height": "1.05", "white-space": "pre-line", "text-wrap": "balance", "overflow-wrap": "anywhere" },
    ".intro": { "max-width": "460px", "margin": "28px auto 34px", "color": "var(--muted)", "font-size": "clamp(17px, 3vw, 20px)", "line-height": "1.7", "overflow-wrap": "anywhere" },
    ".landing-cta": { "display": "inline-flex", "align-items": "center", "justify-content": "center", "gap": "20px", "min-height": "56px", "max-width": "100%", "padding": "16px 26px", "border": "1px solid transparent", "border-radius": "999px", "background": "var(--accent)", "color": "var(--on-accent)", "font-size": "16px", "font-weight": "600", "line-height": "1.5", "text-decoration": "none", "overflow-wrap": "anywhere", "touch-action": "manipulation", "transition": "background-color 160ms ease, transform 160ms ease" },
    ".landing-cta:hover": { "background": "var(--accent-hover)" },
    ".landing-cta:active": { "transform": "translateY(1px)" },
    ".site-footer": { "margin": "0 24px", "padding": "24px 0 max(28px, env(safe-area-inset-bottom))", "border-top": "1px solid var(--border)", "text-align": "center", "color": "var(--muted)", "font-size": "13px", "line-height": "1.6", "overflow-wrap": "anywhere" },
    ".site-footer p": { "margin": "0" },
    ":focus-visible": { "outline": "3px solid var(--accent)", "outline-offset": "5px" },
    ".skip-link": { "position": "fixed", "top": "12px", "left": "12px", "z-index": "2", "padding": "12px 18px", "border-radius": "10px", "background": "var(--text)", "color": "var(--on-accent)", "transform": "translateY(-200%)" },
    ".skip-link:focus": { "transform": "translateY(0)" },
    ".page": { "width": "min(100%, 600px)", "margin-inline": "auto", "padding": "80px 24px", "text-align": "center" },
    ".page a": { "display": "inline-block", "padding": "16px", "color": "var(--accent)" }
  },
  "media": {
    "(max-width: 350px)": { ".landing": { "padding-inline": "18px" }, ".site-header": { "padding-inline": "18px" } },
    "(prefers-reduced-motion: reduce)": { "*, *::before, *::after": { "transition": "none !important" } },
    "(forced-colors: active)": { ".landing-cta, .brand-mark": { "border": "1px solid ButtonText" } }
  },
  "keyframes": {}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Profile Page configuration",
  "description": "Backward-compatible site content and optional progressive enhancements. Build validation additionally checks URLs, computed link ID uniqueness, safe styling, image paths, and production readiness.",
  "type": "object",
  "required": [
    "name",
    "bio",
    "description",
    "siteUrl",
    "placeholderLinks",
    "profile",
    "primaryLink",
    "secondaryLinks",
    "previewNote",
    "seo",
    "appearance",
    "analytics"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ],
      "default": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "bio": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "siteUrl": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/httpsURL"
        }
      ]
    },
    "profilePath": {
      "type": "string",
      "default": "/",
      "pattern": "^/(?:[a-z0-9][a-z0-9-]{0,63})?(?![\\s\\S])",
      "not": { "enum": ["/example", "/assets", "/images"] },
      "description": "Use / for a legacy root profile, or /sample-creator for a profile beside the platform landing. /example is reserved for the neutral demo. Do not include a trailing slash on a slug."
    },
    "landing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional platform landing overrides; independent of creator settings and the neutral demo. Defaults are in landing.example.json.",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "initials": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "eyebrow": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "headline": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "ctaLabel": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "footer": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "appearance": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "browserThemeColor": { "$ref": "#/$defs/color" },
            "faviconBackground": { "$ref": "#/$defs/color" },
            "faviconText": { "$ref": "#/$defs/color" },
            "colorScheme": { "enum": ["light", "dark", "light dark", "dark light"] }
          }
        },
        "styles": { "$ref": "#/properties/styles" }
      }
    },
    "placeholderLinks": {
      "type": "boolean"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional server-enforced Turnstile gate. Credentials belong in Worker runtime settings, never this file. Defaults are disabled, 60 minutes, and automatic widget theme.",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "sessionMinutes": { "type": "integer", "minimum": 5, "maximum": 1440, "default": 60 },
        "widgetTheme": { "enum": ["auto", "light", "dark"], "default": "auto" },
        "styles": { "$ref": "#/properties/styles" },
        "copy": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "heading": { "$ref": "#/$defs/verificationText" },
            "description": { "$ref": "#/$defs/verificationText" },
            "footer": { "$ref": "#/$defs/verificationText" },
            "loading": { "$ref": "#/$defs/verificationText" },
            "verifying": { "$ref": "#/$defs/verificationText" },
            "error": { "$ref": "#/$defs/verificationText" },
            "expired": { "$ref": "#/$defs/verificationText" },
            "unavailable": { "$ref": "#/$defs/verificationText" },
            "noScript": { "$ref": "#/$defs/verificationText" },
            "retry": { "$ref": "#/$defs/verificationText" }
          }
        }
      }
    },
    "previewNote": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "required": [
        "initials",
        "image"
      ],
      "properties": {
        "initials": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "image": {
          "type": "string",
          "description": "Empty, an HTTPS image URL, or a local /images/ raster path. The build checks paths and symlinks."
        },
        "alt": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "image": {
                "not": {
                  "const": ""
                }
              }
            }
          },
          "then": {
            "required": [
              "alt"
            ],
            "properties": {
              "alt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "primaryLink": {
      "$ref": "#/$defs/link"
    },
    "secondaryLinks": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/link"
          },
          {
            "required": [
              "enabled"
            ]
          }
        ]
      }
    },
    "seo": {
      "type": "object",
      "required": [
        "title",
        "image"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "image": {
          "type": "string",
          "description": "Empty, an HTTPS image URL, or a local /images/ raster path. The build checks paths and symlinks."
        },
        "imageAlt": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "image": {
                "not": {
                  "const": ""
                }
              }
            }
          },
          "then": {
            "required": [
              "imageAlt"
            ],
            "properties": {
              "imageAlt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "appearance": {
      "type": "object",
      "required": [
        "browserThemeColor",
        "colorScheme",
        "faviconBackground",
        "faviconText"
      ],
      "properties": {
        "browserThemeColor": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "faviconBackground": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "faviconText": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "colorScheme": {
          "enum": [
            "light",
            "dark",
            "light dark",
            "dark light"
          ]
        }
      }
    },
    "styles": {
      "type": "object",
      "description": "Recursive overrides to theme.json; null removes an inherited entry."
    },
    "browserOpening": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "native"
          ],
          "default": "direct"
        },
        "autoOpen": {
          "type": "boolean",
          "default": false
        },
        "showManual": {
          "type": "boolean",
          "default": true
        },
        "iosStrategy": {
          "enum": [
            "instagram",
            "safari"
          ],
          "default": "instagram"
        },
        "androidPackage": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)+$",
          "default": "com.android.chrome"
        },
        "fallbackDelayMs": {
          "type": "integer",
          "minimum": 800,
          "maximum": 5000,
          "default": 1800
        },
        "labels": {
          "type": "object",
          "properties": {
            "open": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "retry": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "continue": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "dismiss": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "pending": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "unconfirmed": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "iosInstructions": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            },
            "androidInstructions": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 500
            }
          },
          "additionalProperties": false
        }
      }
    },
    "ageAcknowledgment": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 500
        },
        "remember": {
          "enum": [
            "session",
            "none"
          ],
          "default": "session"
        }
      }
    },
    "analytics": {
      "type": "object",
      "required": [
        "cloudflareToken"
      ],
      "properties": {
        "cloudflareToken": {
          "type": "string",
          "pattern": "^(?:[a-fA-F0-9]{32})?$"
        },
        "ga4MeasurementId": {
          "type": "string",
          "pattern": "^(?:G-[A-Z0-9]{4,20})?$",
          "default": ""
        },
        "ga4Consent": {
          "enum": [
            "required",
            "granted"
          ],
          "default": "required"
        },
        "debug": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "verificationText": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
    "color": { "type": "string", "minLength": 7, "maxLength": 7, "pattern": "^#[a-fA-F0-9]{6}$" },
    "httpsURL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s\\\\]+$",
      "not": {
        "pattern": "^https://[^/?#]*@"
      }
    },
    "link": {
      "type": "object",
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "anyOf": [{ "$ref": "#/$defs/httpsURL" }, { "const": "/example/more-soon/" }],
          "description": "HTTPS destination, or the exact built-in More soon route while placeholderLinks is true. The build rejects placeholders for production."
        },
        "icon": {
          "enum": [
            "none",
            "arrow",
            "heart"
          ],
          "default": "none"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,40}$"
        },
        "openingMode": {
          "enum": [
            "inherit",
            "direct",
            "native"
          ],
          "default": "inherit"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

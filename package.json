{
  "name": "static-profile-page",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:example": "node scripts/build.mjs --example",
    "build:production": "node scripts/build.mjs --production",
    "build:private": "node scripts/build.mjs --private",
    "build:private:production": "node scripts/build.mjs --private --production",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "dev:private": "node scripts/build.mjs --private && node scripts/serve.mjs --private",
    "preview": "node scripts/serve.mjs",
    "preview:private": "node scripts/serve.mjs --private",
    "check:public": "node scripts/check-public.mjs",
    "check:crawl": "node scripts/crawl-check.mjs",
    "check:crawl:browser": "node scripts/browser-crawl-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "example:refresh": "node scripts/example.mjs",
    "test:browser": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "check:performance": "node scripts/performance.mjs",
    "check:workers": "npm run build:example && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "wrangler": "4.154.0"
  }
}

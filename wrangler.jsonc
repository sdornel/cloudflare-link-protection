{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-link-protection",
  "compatibility_date": "2026-10-27",
  "main": "./src/worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
